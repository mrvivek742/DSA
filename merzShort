#include <iostream>

void merge(int arr[], int low, int mid, int high) {
    int temp[100];
    int i = low;      // FIX: Must initialize i to the start of the first subarray
    int j = mid + 1;  // FIX: Must initialize j to the start of the second subarray
    int k = low;      // FIX: Must initialize k to track the temp array index

    // Merge the two sorted subarrays into temp[]
    while (i <= mid && j <= high) {
        if (arr[i] < arr[j]) {
            temp[k++] = arr[i++];
        } else {
            temp[k++] = arr[j++];
        }
    }

    // Copy remaining elements of the left subarray, if any
    while (i <= mid) {
        temp[k++] = arr[i++];
    }

    // Copy remaining elements of the right subarray, if any
    while (j <= high) {
        temp[k++] = arr[j++];
    }

    // Copy the sorted elements back into the original array
    for (i = low; i <= high; i++) {
        arr[i] = temp[i];
    }
}

void mergeSort(int arr[], int low, int high) {
    if (low < high) {
        // FIX: Calculate mid point before making recursive calls
        int mid = low + (high - low) / 2; 
        
        // Recursively sort first and second halves
        mergeSort(arr, low, mid);
        mergeSort(arr, mid + 1, high); // FIX: Right half starts at mid + 1
        
        // Merge the sorted halves
        merge(arr, low, mid, high);    // FIX: Missing the call to merge()
    }
}
int main() {
    int n;
    printf("Enter number of elements: ");
    scanf("%d", &n);

    int arr[n]; // Variable Length Array (VLA)
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    mergeSort(arr, 0, n - 1);

    printf("Sorted array:\n");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}

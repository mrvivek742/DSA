#include <stdio.h>
#include<stdlib.h>
struct Node{
    int data;
    struct Node *next;
    
};
struct Node *createHeader(){
    struct Node *header;
    header= (struct Node*)malloc (sizeof(struct Node));
    header->data=0;
    header->next=NULL;
    return header;
} 
void insert(struct Node *header,int value){
    struct Node *newNode;
    newNode= (struct Node*)malloc (sizeof(struct Node));
    newNode->data=value;
    newNode->next=header->next;
    header->next = newNode;
    header->data++;
}
void printList(struct Node* header){
    struct Node* temp = header-> next;
    printf("list content: ");
    while(temp != NULL){
        printf("%d",temp->data);
        if (temp->next!=NULL){
            printf("->");
        }
        temp=temp->next;
    }
    printf("\n");
}

int main()
{
    int n;
    struct Node *header;
    header = createHeader();
    scanf("%d",&n);
    while(n>0){
        int value;
        scanf("%d",&value);
        insert(header,value);
        n--;
        
    }
    printList(header);
    return 0;
}

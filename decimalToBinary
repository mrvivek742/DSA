#include <stdio.h>

void printBinary(int n) {
    if (n > 1) 
        printBinary(n / 2); // Recursive call
    printf("%d", n % 2);    // Prints remainders on the way back
}

int main() {
    int num;
    printf("Enter a decimal number: ");
    scanf("%d", &num);
    
    printf("Binary: ");
    printBinary(num);
    printf("\n");
    return 0;
}
